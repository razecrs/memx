    "portability_fix": {
      "problem": "MemX required max_align_t alignment from every small internal allocation; Android Bionic/Scudo can return an 8-byte-aligned small allocation while this NDK reports max_align_t alignment as 16, causing false out-of-memory failures.",
      "resolution": "Require max(_Alignof(uintptr_t), 4), which covers every v0 internal allocated type and the descriptor's two tag bits; compile-time assertions enforce the internal-type invariant.",
      "regression_result": "The Android suite changed from cascading OOM failures and SIGSEGV to a complete pass."
    }
